# 总开关：true 时强制走 Mock（断网也能演示，永不翻车）
USE_MOCK=true

# 知乎开放平台（开发者个人中心申请，只显示一次，绝不进 Git）
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE=https://developer.zhihu.com

# LLM 通道：zhida（知乎直答，默认）/ external（任意 OpenAI 兼容模型）/ mock
LLM_PROVIDER=zhida
ZHIDA_MODEL=zhida-thinking-1p5
ZHIDA_FAST_MODEL=zhida-fast-1p5

# 备用通道（任意 OpenAI 兼容模型）
EXTERNAL_BASE_URL=https://api.deepseek.com/v1
EXTERNAL_API_KEY=
EXTERNAL_MODEL=deepseek-chat

REQUEST_TIMEOUT=20
