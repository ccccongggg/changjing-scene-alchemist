# 统一行尾策略：仓库内存 LF，检出时由 Git 自动处理，避免 Windows 上产生无意义 diff
* text=auto

# 明确二进制文件，防止被当作文本改写
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary

# 构建产物按原样保存，不做行尾转换
backend/site/assets/* -text
frontend/dist/** -text
